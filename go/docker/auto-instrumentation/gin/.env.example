# Copy to .env and fill in your own values:  cp .env.example .env
#
# .env is git-ignored at the repo root. Never commit real tokens.

# Managed OTLP endpoint — use the receiver for your Sematext Cloud region:
#   EU: https://otlp-receiver.eu.sematext.com
#   US: https://otlp-receiver.sematext.com
SEMATEXT_OTLP_ENDPOINT=https://otlp-receiver.eu.sematext.com

# Service name reported to Sematext
OTEL_SERVICE_NAME=go-gin-docker-auto

# Per-App tokens (Sematext Cloud -> each App -> Settings -> Tokens)
SEMATEXT_TRACES_TOKEN=your-tracing-app-token
SEMATEXT_MONITORING_TOKEN=your-monitoring-app-token
SEMATEXT_LOGS_TOKEN=your-logs-app-token

# OBI log level: info, debug
OTEL_EBPF_LOG_LEVEL=info
