# Copy to .env and fill in your own values:  cp .env.example .env
#
# .env is git-ignored at the repo root. Never commit real tokens.

# Sematext Cloud region: US or EU
REGION=US

# Infrastructure token (Sematext Cloud -> Account -> Infrastructure)
INFRA_TOKEN=your-infra-token

# Per-App tokens (Sematext Cloud -> each App -> Settings -> Tokens)
SEMATEXT_TRACES_TOKEN=your-tracing-app-token
SEMATEXT_MONITORING_TOKEN=your-monitoring-app-token
SEMATEXT_LOGS_TOKEN=your-logs-app-token

# otelc diagnostic log level: debug, info, warn, error
OTEL_LOG_LEVEL=info
